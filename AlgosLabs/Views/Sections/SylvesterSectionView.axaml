<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AlgosLabs.ViewModels"
             x:Class="AlgosLabs.Views.Sections.SylvesterSectionView"
             x:DataType="vm:SylvesterViewModel">

    <ScrollViewer>
        <StackPanel Spacing="16" Margin="16">

            <Border Background="{DynamicResource SystemRegionBrush}"
                    Theme="{StaticResource CardBorderTheme}"
                    CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Вычисление n-го члена" FontWeight="SemiBold" FontSize="16"/>
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding NRangeText}" FontSize="12"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                        <NumericUpDown Value="{Binding N}" Minimum="0" Maximum="40"
                                       Increment="1" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                    <Button Command="{Binding ComputeSylvesterCommand}" Content="Вычислить"
                            Classes="accent" IsEnabled="{Binding !IsBusy}" HorizontalAlignment="Stretch"/>
                    <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                            CornerRadius="4" Padding="12">
                        <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" FontFamily="Consolas"/>
                    </Border>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource SystemRegionBrush}"
                    Theme="{StaticResource CardBorderTheme}"
                    CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Замер времени (бенчмарк)" FontWeight="SemiBold" FontSize="16"/>
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding MaxNRangeText}" FontSize="12"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                        <NumericUpDown Value="{Binding MaxBenchmarkN}" Minimum="1" Maximum="40"
                                       Increment="1" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                    <Button Command="{Binding RunSylvesterBenchmarkCommand}" Content="Построить график"
                            Classes="accent" IsEnabled="{Binding !IsBusy}" HorizontalAlignment="Stretch"/>
                    <TextBlock Text="{Binding BenchmarkStatus}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>