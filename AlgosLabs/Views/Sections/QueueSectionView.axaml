<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AlgosLabs.ViewModels"
             x:Class="AlgosLabs.Views.Sections.QueueSectionView"
             x:DataType="vm:QueueViewModel">

    <!-- Раздел «Очередь»: команды из файла, замеры двух реализаций и сравнение составов. -->
    <Grid ColumnDefinitions="360, *" ColumnSpacing="12" Margin="0,12,0,0">

        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="12">

                <!-- Операции из input.txt. -->
                <Border Background="{DynamicResource SystemRegionBrush}" CornerRadius="8" Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Операции из файла" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="Команды через пробел: 1,значение — вставка, 2 — удаление, 3 — начало очереди, 4 — isEmpty, 5 — печать."
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />

                        <TextBlock Text="Реализация:" FontSize="11"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                        <ComboBox ItemsSource="{Binding ImplementationNames}"
                                  SelectedIndex="{Binding SelectedImplementationIndex}"
                                  HorizontalAlignment="Stretch" />

                        <TextBox Text="{Binding InputFilePath}" PlaceholderText="Путь к input.txt" />

                        <Grid ColumnDefinitions="*, *" ColumnSpacing="6">
                            <Button Grid.Column="0"
                                    Content="Создать пример"
                                    Command="{Binding CreateSampleInputFileCommand}"
                                    IsEnabled="{Binding !IsQueueBusy}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Padding="8" />
                            <Button Grid.Column="1"
                                    Content="Выполнить"
                                    Command="{Binding RunQueueOperationsCommand}"
                                    IsEnabled="{Binding !IsQueueBusy}"
                                    Classes="accent"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Padding="8" />
                        </Grid>

                        <Button Content="Замерить текущий файл (5 прогонов)"
                                Command="{Binding MeasureCurrentInputFileCommand}"
                                IsEnabled="{Binding !IsQueueBusy}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Padding="8" />

                        <TextBlock Text="{Binding QueueFinalState}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                    </StackPanel>
                </Border>

                <!-- Замер при разной длине набора. -->
                <Border Background="{DynamicResource SystemRegionBrush}" CornerRadius="8" Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Замер: разная длина" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="Обе реализации на наборах разной длины. Глубина очереди растёт вместе с N."
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />

                        <Grid ColumnDefinitions="*, *, *" ColumnSpacing="6">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="N от:" FontSize="11"
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                <NumericUpDown Value="{Binding BenchmarkStartN}"
                                               Minimum="1" Maximum="1000000" Increment="100"
                                               HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="N до:" FontSize="11"
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                <NumericUpDown Value="{Binding BenchmarkMaxN}"
                                               Minimum="1" Maximum="5000000" Increment="1000"
                                               HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="4">
                                <TextBlock Text="Шаг:" FontSize="11"
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                <NumericUpDown Value="{Binding BenchmarkStepN}"
                                               Minimum="1" Maximum="100000" Increment="100"
                                               HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Grid>

                        <Button Content="Построить график обеих реализаций"
                                Command="{Binding RunQueueBenchmarkCommand}"
                                IsEnabled="{Binding !IsQueueBusy}"
                                Classes="accent"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Padding="8" />
                    </StackPanel>
                </Border>

                <!-- Одинаковая длина, разный состав. -->
                <Border Background="{DynamicResource SystemRegionBrush}" CornerRadius="8" Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Одинаковая длина, разный состав" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="Два набора по N команд: «глубокий» (много удалений при большой очереди) и «мелкий» (удаления почти без роста очереди)."
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />

                        <StackPanel Spacing="4">
                            <TextBlock Text="Длина каждого набора:" FontSize="11"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                            <NumericUpDown Value="{Binding CompositionLength}"
                                           Minimum="10" Maximum="1000000" Increment="1000"
                                           HorizontalAlignment="Stretch" />
                        </StackPanel>

                        <Button Content="Сравнить составы"
                                Command="{Binding RunCompositionComparisonCommand}"
                                IsEnabled="{Binding !IsQueueBusy}"
                                Classes="accent"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Padding="8" />
                    </StackPanel>
                </Border>

                <ProgressBar IsIndeterminate="True"
                             IsVisible="{Binding IsQueueBusy}"
                             Height="3"
                             HorizontalAlignment="Stretch" />
            </StackPanel>
        </ScrollViewer>

        <!-- Результаты. -->
        <Grid Grid.Column="1" RowDefinitions="*, *" RowSpacing="12">

            <Border Grid.Row="0"
                    Background="{DynamicResource SystemRegionBrush}"
                    CornerRadius="8"
                    Padding="12">
                <Grid RowDefinitions="Auto, *">
                    <TextBlock Grid.Row="0"
                               Text="Результат выполнения команд"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Margin="0,0,0,8" />

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto">
                        <SelectableTextBlock Text="{Binding QueueLog}"
                                             FontSize="12"
                                             TextWrapping="NoWrap" />
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Background="{DynamicResource SystemRegionBrush}"
                    CornerRadius="8"
                    Padding="12">
                <Grid RowDefinitions="Auto, *">
                    <TextBlock Grid.Row="0"
                               Text="Сравнение реализаций"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Margin="0,0,0,8" />

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto">
                        <SelectableTextBlock Text="{Binding CompositionReport}"
                                             FontSize="12"
                                             TextWrapping="Wrap" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
