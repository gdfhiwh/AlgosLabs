<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AlgosLabs.ViewModels"
             x:Class="AlgosLabs.Views.Sections.LinkedListSectionView"
             x:DataType="vm:LinkedListViewModel">

    <!-- Раздел «Связный список»: 12 операций над собственным односвязным списком. -->
    <Grid ColumnDefinitions="360, *" ColumnSpacing="12" Margin="0,12,0,0">

        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="12">

                <Border Background="{DynamicResource SystemRegionBrush}" CornerRadius="8" Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Списки L и E" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="Целые числа через пробел или запятую. Для операции 9 оба списка можно считать из файла (первая строка — L, вторая — E)."
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />

                        <StackPanel Spacing="4">
                            <TextBlock Text="Список L:" FontSize="11"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                            <TextBox Text="{Binding ListText}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="70" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Список E:" FontSize="11"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                            <TextBox Text="{Binding ListEText}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="52" />
                        </StackPanel>

                        <TextBox Text="{Binding ListsFilePath}" PlaceholderText="Путь к lists.txt" />

                        <Grid ColumnDefinitions="*, *" ColumnSpacing="6">
                            <Button Grid.Column="0"
                                    Content="Создать пример"
                                    Command="{Binding CreateSampleFileCommand}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Padding="8" />
                            <Button Grid.Column="1"
                                    Content="Из файла"
                                    Command="{Binding LoadListsFromFileCommand}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Padding="8" />
                        </Grid>

                        <Button Content="Применить введённые списки"
                                Command="{Binding ApplyInputsCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Padding="8" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Column="1" RowDefinitions="Auto, *" RowSpacing="12">

            <Border Grid.Row="0"
                    Background="{DynamicResource SystemRegionBrush}"
                    CornerRadius="8"
                    Padding="12">
                <StackPanel Spacing="8">
                    <TextBlock Text="Операция" FontWeight="SemiBold" FontSize="14" />

                    <ComboBox ItemsSource="{Binding OperationNames}"
                              SelectedIndex="{Binding OperationIndex}"
                              HorizontalAlignment="Stretch" />

                    <TextBlock Text="{Binding SelectedOperationDescription}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />

                    <StackPanel Spacing="4" IsVisible="{Binding NeedsX}">
                        <TextBlock Text="Число x:" FontSize="11"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                        <NumericUpDown Value="{Binding ParameterX}"
                                       Minimum="-1000000" Maximum="1000000" Increment="1"
                                       HorizontalAlignment="Stretch" />
                    </StackPanel>

                    <StackPanel Spacing="4" IsVisible="{Binding NeedsE}">
                        <TextBlock Text="Элемент E:" FontSize="11"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                        <NumericUpDown Value="{Binding ParameterE}"
                                       Minimum="-1000000" Maximum="1000000" Increment="1"
                                       HorizontalAlignment="Stretch" />
                    </StackPanel>

                    <StackPanel Spacing="4" IsVisible="{Binding NeedsF}">
                        <TextBlock Text="Новый элемент F:" FontSize="11"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                        <NumericUpDown Value="{Binding ParameterF}"
                                       Minimum="-1000000" Maximum="1000000" Increment="1"
                                       HorizontalAlignment="Stretch" />
                    </StackPanel>

                    <StackPanel Spacing="4" IsVisible="{Binding NeedsPositions}">
                        <Grid ColumnDefinitions="*, *" ColumnSpacing="8">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="Позиция 1:" FontSize="11"
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                <NumericUpDown Value="{Binding PositionFirst}"
                                               Minimum="1" Maximum="1000000" Increment="1"
                                               HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="Позиция 2:" FontSize="11"
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                <NumericUpDown Value="{Binding PositionSecond}"
                                               Minimum="1" Maximum="1000000" Increment="1"
                                               HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <Button Content="Выполнить"
                            Command="{Binding RunOperationCommand}"
                            Classes="accent"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Padding="8" />
                </StackPanel>
            </Border>

            <Border Grid.Row="1"
                    Background="{DynamicResource SystemRegionBrush}"
                    CornerRadius="8"
                    Padding="12">
                <Grid RowDefinitions="Auto, Auto, Auto, Auto, *">
                    <TextBlock Grid.Row="0"
                               Text="Результат"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Margin="0,0,0,8" />

                    <TextBlock Grid.Row="1"
                               Text="Текущий список L:"
                               FontSize="11"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                    <SelectableTextBlock Grid.Row="2"
                                         Text="{Binding CurrentList}"
                                         FontSize="15"
                                         FontWeight="SemiBold"
                                         TextWrapping="Wrap"
                                         Margin="0,0,0,6" />

                    <StackPanel Grid.Row="3" Spacing="2" Margin="0,0,0,6">
                        <TextBlock Text="Список E:"
                                   FontSize="11"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                        <SelectableTextBlock Text="{Binding CurrentListE}"
                                             FontSize="13"
                                             TextWrapping="Wrap" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="4"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <SelectableTextBlock Text="{Binding ResultMessage}"
                                             FontSize="12"
                                             TextWrapping="Wrap"
                                             Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
